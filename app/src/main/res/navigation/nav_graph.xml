<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.brailleglove.ui.home.HomeFragment"
        android:label="Home">
        <action android:id="@+id/action_home_to_learning"
            app:destination="@id/learningFragment"/>
        <action android:id="@+id/action_home_to_practice"
            app:destination="@id/practiceFragment"/>
        <action android:id="@+id/action_home_to_test"
            app:destination="@id/testFragment"/>
    </fragment>

    <fragment
        android:id="@+id/learningFragment"
        android:name="com.example.brailleglove.ui.learning.LearningFragment"
        android:label="Learning"/>

    <fragment
        android:id="@+id/practiceFragment"
        android:name="com.example.brailleglove.ui.practice.PracticeFragment"
        android:label="Practice"/>

    <fragment
        android:id="@+id/testFragment"
        android:name="com.example.brailleglove.ui.test.TestFragment"
        android:label="Test"/>

</navigation>