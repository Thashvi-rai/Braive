<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Same structure as values/themes.xml; color roles resolve against
         values-night/colors.xml automatically. Only the status bar icon
         contrast direction needs to flip for a dark background. -->
    <style name="Base.Theme.BrailleGlove" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/atkinson_hyperlegible</item>
        <item name="fontFamily">@font/atkinson_hyperlegible</item>

        <item name="colorPrimary">@color/mode_learning</item>
        <item name="colorOnPrimary">@color/mode_learning_on</item>
        <item name="colorPrimaryContainer">@color/mode_learning_container</item>
        <item name="colorOnPrimaryContainer">@color/mode_learning_on_container</item>

        <item name="colorSecondary">@color/mode_practice</item>
        <item name="colorOnSecondary">@color/mode_practice_on</item>
        <item name="colorSecondaryContainer">@color/mode_practice_container</item>
        <item name="colorOnSecondaryContainer">@color/mode_practice_on_container</item>

        <item name="colorTertiary">@color/mode_test</item>
        <item name="colorOnTertiary">@color/mode_test_on</item>
        <item name="colorTertiaryContainer">@color/mode_test_container</item>
        <item name="colorOnTertiaryContainer">@color/mode_test_on_container</item>

        <item name="colorError">@color/state_error</item>
        <item name="colorOnError">@color/state_error_on</item>
        <item name="colorErrorContainer">@color/state_error_container</item>
        <item name="colorOnErrorContainer">@color/state_error_on_container</item>

        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorOnBackground">@color/brand_ink</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_ink</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/brand_ink_soft</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorOutlineVariant">@color/brand_outline_variant</item>

        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
